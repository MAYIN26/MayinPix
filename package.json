{
  "name": "pixelcut-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PixelCut Studio — local, lossless background removal (AI, chroma key, pixel art)",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "next build",
    "start": "node scripts/serve.mjs 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.540.0",
    "next": "^15.5.29",
    "onnxruntime-web": "^1.22.0",
